[Unit]
Description=AI Teacher FastAPI Server
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/AI_Teacher
EnvironmentFile=/home/ubuntu/AI_Teacher/.env
ExecStart=/home/ubuntu/AI_Teacher/.venv/bin/python -m uvicorn src.main:app --host 0.0.0.0 --port 3018 --workers 4
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
