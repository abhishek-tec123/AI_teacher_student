[Unit]
Description=AI Teacher FastAPI Server
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/AI_Teacher/AI_tescher_student
EnvironmentFile=/home/ubuntu/AI_Teacher/AI_tescher_student/.env
ExecStart=/home/ubuntu/AI_Teacher/AI_tescher_student/.venv/bin/python -m uvicorn --app-dir /home/ubuntu/AI_Teacher/AI_tescher_student/src main:app --host 0.0.0.0 --port 3018 --workers 2
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
